# ---------------------------------------------------------------------------
# Copy to .env.local for local dev, and set the same keys in Vercel for prod.
# ---------------------------------------------------------------------------

# MongoDB connection string (MongoDB Atlas recommended for production)
MONGODB_URI=

# Secret used to sign JWT auth tokens — a long random string
JWT_SECRET=
JWT_EXPIRE=30d

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional Gemini model override (defaults to gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Only needed if the frontend should call an EXTERNAL API instead of its own
# same-origin /api routes:
# NEXT_PUBLIC_API_URL=/api
